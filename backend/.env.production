# Production Environment Variables for Render.com
# Server Configuration
PORT=$PORT
NODE_ENV=production
CLIENT_URL=$RENDER_EXTERNAL_URL

# Database (use your MongoDB Atlas connection string)
MONGODB_URL=$MONGODB_URL

# Authentication (generate strong secrets)
JWT_SECRET=$JWT_SECRET

# Stripe Payment Configuration
STRIPE_SECRET_KEY=$STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=$STRIPE_WEBHOOK_SECRET

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=$CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=$CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=$CLOUDINARY_API_SECRET

# Render.com Environment
RENDER_SERVICE_NAME=eventifyx-backend
RENDER_SERVICE_ID=$RENDER_SERVICE_ID
