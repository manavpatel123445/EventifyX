# Backend environment configuration for EventifyX
# Copy this file to `.env` and fill in real values.

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas for production)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/eventifyx

# Auth
JWT_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=10d
ADMIN_SECRET=your-admin-creation-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Render.com deployment
# For production, use MongoDB Atlas connection string above
